<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference
        android:icon="@drawable/ic_cyclon_sync_contacts"
        android:key="pref_sync_contacts"
        android:persistent="false"
        android:title="@string/cyclon_sync_contacts_title"
        android:summary="@string/cyclon_sync_unknown">
        <intent android:targetClass="org.microg.gms.people.ContactsSyncActivity"
            android:targetPackage="@string/package_id" />
    </Preference>
    <Preference
        android:icon="@drawable/ic_cyclon_sync_calendar"
        android:key="pref_sync_calendar"
        android:persistent="false"
        android:title="@string/cyclon_sync_calendar_title"
        android:summary="@string/cyclon_sync_unknown">
        <intent android:targetClass="org.microg.gms.calendar.CalendarSyncActivity"
            android:targetPackage="@string/package_id" />
    </Preference>
    <Preference
        android:icon="@drawable/ic_cyclon_passwords"
        android:key="pref_sync_passwords"
        android:persistent="false"
        android:title="@string/cyclon_sync_passwords_row_title"
        android:summary="@string/cyclon_passwords_manage">
        <intent android:targetClass="com.google.android.gms.credential.manager.PasswordManagerActivity"
            android:targetPackage="@string/package_id" />
    </Preference>
</PreferenceScreen>
