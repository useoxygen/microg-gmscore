    <!-- Titles use the UI font; Space Mono is reserved for the agent's voice and clock digits. -->
    <style name="TextAppearance.CyclonServices.Title" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif</item>
