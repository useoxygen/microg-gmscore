    <!-- Draft 4, "ink on paper, one highlight", for microG's own windows (sign-in, consent and
         permission dialogs). Paper/black surfaces and ink text and buttons follow day/night through
         the cyclon_* colours; the owner's highlight (colorPrimary) is left to on/selected states and
         progress. The text font is the system sans-serif, which is Manrope on Cyclon OS. -->
    <style name="Theme.Cyclon" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/cyclon_paper</item>
        <item name="colorOnBackground">@color/cyclon_ink</item>
        <item name="colorSurface">@color/cyclon_paper</item>
        <item name="colorOnSurface">@color/cyclon_ink</item>
        <item name="colorSurfaceVariant">@color/cyclon_panel</item>
        <item name="colorOnSurfaceVariant">@color/cyclon_muted</item>
        <item name="colorSurfaceBright">@color/cyclon_paper</item>
        <item name="colorSurfaceDim">@color/cyclon_paper</item>
        <item name="colorSurfaceContainerLowest">@color/cyclon_paper</item>
        <item name="colorSurfaceContainerLow">@color/cyclon_paper</item>
        <item name="colorSurfaceContainer">@color/cyclon_paper</item>
        <item name="colorSurfaceContainerHigh">@color/cyclon_raised</item>
        <item name="colorSurfaceContainerHighest">@color/cyclon_panel</item>
        <item name="colorSurfaceInverse">@color/cyclon_ink</item>
        <item name="colorOnSurfaceInverse">@color/cyclon_paper</item>
        <item name="colorOutline">@color/cyclon_line</item>
        <item name="colorOutlineVariant">@color/cyclon_line</item>
        <item name="colorPrimary">@color/cyclon_highlight</item>
        <item name="colorOnPrimary">@color/cyclon_paper</item>
        <item name="colorPrimaryContainer">@color/cyclon_panel</item>
        <item name="colorOnPrimaryContainer">@color/cyclon_ink</item>
        <item name="colorSecondary">@color/cyclon_ink</item>
        <item name="colorOnSecondary">@color/cyclon_paper</item>
        <item name="colorSecondaryContainer">@color/cyclon_panel</item>
        <item name="colorOnSecondaryContainer">@color/cyclon_ink</item>
        <item name="colorTertiary">@color/cyclon_highlight</item>
        <item name="colorOnTertiary">@color/cyclon_paper</item>
        <item name="colorTertiaryContainer">@color/cyclon_panel</item>
        <item name="colorOnTertiaryContainer">@color/cyclon_ink</item>
        <item name="colorError">@color/cyclon_error</item>
        <item name="colorOnError">@android:color/white</item>
        <item name="colorAccent">@color/cyclon_highlight</item>
        <item name="android:textColorLink">@color/cyclon_ink</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialButtonStyle">@style/Widget.Cyclon.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Cyclon.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Cyclon.Button.Text</item>
        <item name="buttonBarButtonStyle">@style/Widget.Cyclon.Button.Text.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Cyclon.Button.Text.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Cyclon.Button.Text.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Cyclon.Button.Text.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Cyclon.Dialog.Alert</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Cyclon.MaterialAlertDialog</item>
        <!-- Bars take the page colour; targetSdk 29 does not enforce edge-to-edge. -->
        <item name="android:statusBarColor">@color/cyclon_paper</item>
        <item name="android:navigationBarColor">@color/cyclon_paper</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">@bool/cyclon_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/cyclon_light_system_bars</item>
    </style>

