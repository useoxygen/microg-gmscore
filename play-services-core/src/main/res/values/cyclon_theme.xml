    <style name="Widget.Cyclon.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/cyclon_button_ink</item>
        <item name="strokeColor">@color/cyclon_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Cyclon.Button</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ShapeAppearance.Cyclon.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
