    <!-- Primary: filled ink with paper text. Secondary/text: ink text. Outlined: hairline + ink. -->
    <style name="Widget.Cyclon.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cyclon_button_fill</item>
        <item name="android:textColor">@color/cyclon_button_on_fill</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Cyclon.Button</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Cyclon.Button.Text" parent="Widget.Material3.Button.TextButton">
