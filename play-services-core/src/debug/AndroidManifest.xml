<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Already in the main manifest; repeated because lint's MissingPermission check reads this debug manifest
         alone and would otherwise flag AccountManager.invalidateAuthToken callers. -->
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" />
    <uses-permission android:name="android.permission.USE_CREDENTIALS" />
    <application>
        <activity android:name="org.microg.gms.migration.MigrationWirelessActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:excludeFromRecents="true" />
        <activity-alias android:name="org.microg.gms.migration.MigrationWirelessSetup"
            android:targetActivity="org.microg.gms.migration.MigrationWirelessActivity"
            android:exported="true" android:permission="android.permission.NETWORK_SETUP_WIZARD" />
        <!-- Only debug APKs; shell/root entry, never a production launch surface. -->
        <activity android:name="org.microg.gms.migration.MigrationLabActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:excludeFromRecents="true" />
    </application>
</manifest>
